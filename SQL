--criando a tabela de clientes.

CREATE TABLE cliente(
    codigo_cliente SERIAL PRIMARY KEY,
    email VARCHAR(120) NOT NULL,
    nome VARCHAR(100) NOT NULL,
    telefone VARCHAR(13)
);

--Verificação pra ver se está correto.

SELECT * FROM cliente;

--criando a tabela destinada aos pedidos.

CREATE TABLE pedido(
codigo_pedido SERIAL PRIMARY KEY,
codigo_cliente_fk INTEGER NOT NULL REFERENCES cliente(codigo_cliente),
dt_entrada DATE NOT NULL,
dt_embarque DATE,
tipo VARCHAR(40),
desconto NUMERIC(10,2) DEFAULT 0 CHECK (desconto >= 0),
valor_total NUMERIC(10,2) NOT NULL CHECK (valor_total > 0)
);

-- aqui eu adicionei (espero que certo) a chave estrangeira
--lendo o MER definindo valor total e chave estrangeira e primary_key tambem.

--criando a tabela de produtos.

CREATE TABLE produto(
    codigo_produto SERIAL PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    preco NUMERIC(10,2) NOT NULL CHECK (preco > 0),
    unidade_medida VARCHAR(5) NOT NULL
);

--Agora vou criar a terceira parte, a parte de itens pedidos que onde esta contido algumas especificações da atividade como:
--o codigo do pedido em FOREIGN KEY e do produto, a quantidade e o sub-total.

CREATE TABLE itemPedido(
id_pedido_fk INTEGER NOT NULL REFERENCES pedido(codigo_pedido),
id_produto_fk INTEGER NOT NULL REFERENCES produto(codigo_produto),
quantidade INTEGER NOT NULL CHECK (quantidade > 0),
sub_total NUMERIC(10,2) NOT NULL CHECK (sub_total > 0),
PRIMARY KEY (id_pedido_fk, id_produto_fk)
);


