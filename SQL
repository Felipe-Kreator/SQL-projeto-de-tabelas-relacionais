--mostrando os clientes
SELECT * FROM cliente;

--Mostrando nome e telefone
SELECT nome, telefone FROM cliente;

--listando os clientes em ordem alabetica
SELECT * FROM cliente ORDER BY nome;

--mostrando apenas clientes com nome que começa com a letra 'A'.
SELECT * FROM cliente WHERE nome LIKE 'A%';

--Mostrando somene com 'Silva' no nome.
SELECT * FROM cliente WHERE nome LIKE '%Silva%';

--clientes sem telefone cadastrado.
SELECT * FROM cliente WHERE telefone IS NULL;

--Mostrando agora todos os produtos.
SELECT nome FROM produto;

--mostando agora nome e preço dos prosutos
SELECT nome, preco FROM produto;

--Mostrando agora os produtos em ordem crescente de preço.
SELECT * FROM produto ORDER BY preco;

--mostrando agora os produtos com preço maior a R$ 50,00.
SELECT * FROM produto WHERE preco>50;

--mostrando os produtos com preço entre R$ 10,00 e R$ 100,00.a
SELECT * FROM produto WHERE preco>=10 AND preco<=100;

--mostrando os produtos cujo a unidade é UN.
SELECT nome, unidade_medida FROM produto WHERE unidade_medida='UN';

--mostrando agora os produtos cujo a unidade seja KG ou L
SELECT nome, unidade_medida FROM produto WHERE unidade_medida = 'KG' OR unidade_medida ='L';

--mostrando todos os pedidos.
SELECT * FROM pedido;

--mostrando pedidos com desconto maior que R$0,00.
SELECT codigo_pedido, desconto FROM pedido WHERE desconto>0;

--mostrando agora os pedidos que ainda não foram embarcados.
SELECT * FROM pedido WHERE dt_embarque IS NULL;

--mostrando agora os pedidos que ja foram embarcados.
SELECT * FROM pedido WHERE dt_embarque IS NOT NULL;

--mostrando os que serão realizados em uma data especifica.
SELECT * FROM pedido WHERE dt_embarque = '2026-08-03';

--mostrando o pedido a ser entregue entre duas datas.
SELECT * FROM pedido WHERE dt_embarque >= '2026-08-03' AND dt_embarque <= '2026-09-02';

--mostrando os produtos em ordem decrescente de valor.
SELECT * FROM pedido ORDER BY valor_total DESC;

--mostrando os produtos com valor maior a R$500,00.
SELECT * FROM pedido WHERE valor_total>500;

--mostrando os itens cuja a quantidade é maior que três (3).
SELECT * FROM itemPedido WHERE quantidade > 3;

--mostrando os itens cujo o subtotal seja maior que R$100,00.
SELECT * FROM itemPedido WHERE sub_total > 100;

--mostrando a contagem de clientes cadastrados.
SELECT COUNT(*) FROM cliente;

--mostrando quantos produtos estão cadastrados.
SELECT COUNT(*) FROM produto;

--mostrando o maior preço dos produtos.
SELECT MAX(preco) FROM produto;

--mostrando o menor preço dos produtos.
SELECT MIN(preco) FROM produto;

--Calculando a média dos produtos.
SELECT AVG(preco) FROM produto;

--calculando a soma dos valores dos pedidos.
SELECT SUM(valor_total) FROM pedido;

--contando os pedidos ainda não embarcados.
SELECT COUNT(*) FROM pedido WHERE dt_embarque IS NULL;
